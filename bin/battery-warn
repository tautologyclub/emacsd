#!/bin/bash

BATTERY=/sys/class/power_supply/BAT0
STATE_FILE=/tmp/battery-warn-state

PERCENTAGE=$(cat "$BATTERY/capacity")
STATUS=$(cat "$BATTERY/status")

if [[ "$STATUS" != "Discharging" ]]; then
    rm -f "$STATE_FILE"
    exit 0
fi

LAST=$(cat "$STATE_FILE" 2>/dev/null || echo 100)

(( PERCENTAGE == LAST )) && exit 0

if (( PERCENTAGE <= 9 )); then
    notify-send -u critical "Battery: ${PERCENTAGE}%" "Plug in NOW"
    echo "$PERCENTAGE" > "$STATE_FILE"
elif (( PERCENTAGE <= 10 && LAST > 10 )); then
    notify-send -u critical "Battery critical: 10%" "Plug in now!"
    echo 10 > "$STATE_FILE"
elif (( PERCENTAGE <= 90 && LAST > 90 )); then
    notify-send -u normal "Battery low: ${PERCENTAGE}%" "Consider plugging in"
    echo "$PERCENTAGE" > "$STATE_FILE"
fi
