#!/bin/bash

# i3lock blurred screen inspired by /u/patopop007 and the blog post
# http://plankenau.com/blog/post-10/gaussianlock

# Dependencies:
# imagemagick, i3lock, maim, flock

BMP=/tmp/i3lock.bmp
IMAGE=/tmp/i3lock.png
BLURTYPE="2x8"

# Mutex: exit silently if already running
exec 9>/tmp/blurlock.lock
flock -n 9 || exit 1

# Restore notifications and clean up temp files on exit (covers all paths)
cleanup() {
    rm -f "$BMP" "$IMAGE"
    pkill -u "$USER" -USR2 dunst
}
trap cleanup EXIT

# Silence notifications while locked
pkill -u "$USER" -USR1 dunst

# Lock immediately with gray placeholder — no image generation cost
i3lock -c 333333 &

# Compute blurred screenshot in background
(
    maim "$BMP"
    convert "$BMP" -scale 20% -blur "$BLURTYPE" -scale 500% \
        -define png:compression-level=0 "$IMAGE"
) &
BLUR_PID=$!

wait $BLUR_PID

# Switch to blurred lock only if placeholder is still active (user hasn't unlocked yet)
if pkill -u "$USER" i3lock; then
    # Wake the display before showing the blur — DPMS may have blanked the monitor
    # while we were generating the screenshot, which would hide the lock screen
    # until the user pressed a key.
    xset dpms force on
    /usr/bin/i3lock -n -i "$IMAGE"
fi
